---
interface Props {
  title: string;
  url: string;
  reason: string;
}

const { title, url, reason } = Astro.props;
---

<a href={url} class="cluster-card">
  <div class="cluster-card-icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
    </svg>
  </div>
  <h3 class="cluster-card-title">{title}</h3>
  <p class="cluster-card-reason">{reason}</p>
  <span class="cluster-card-arrow">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </span>
</a>

<style>
  .cluster-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 24px;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
  }

  .cluster-card:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 32px rgba(37, 99, 235, 0.08);
    transform: translateY(-2px);
  }

  .cluster-card-icon {
    width: 36px;
    height: 36px;
    background: var(--accent-soft);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .cluster-card-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.4;
  }

  .cluster-card-reason {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }

  .cluster-card-arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    color: var(--muted-soft);
    opacity: 0;
    transition: all 0.15s ease;
  }

  .cluster-card:hover .cluster-card-arrow {
    opacity: 1;
    color: var(--accent);
    transform: translateX(2px);
  }
</style>
