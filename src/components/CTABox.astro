---
import { site } from '../data/site';

interface Props {
  heading?: string;
  description?: string;
  primaryLabel?: string;
  primaryUrl?: string;
  secondaryLabel?: string;
  secondaryUrl?: string;
  pricingLabel?: string;
  pricingUrl?: string;
}

const {
  heading = "Not sure if your API works? Test before wiring it into production.",
  description = "Check Base URL, API Key, model permissions, and usage signals first. Then use a small test budget to verify Claude Code, Cursor, or Cline before committing.",
  primaryLabel = "Test your API configuration in AI API Doctor",
  primaryUrl = site.aiApiDoctorUrl,
  secondaryLabel = "Create a LinkAI account",
  secondaryUrl = site.linkAIRegisterUrl,
  pricingLabel = "Check LinkAI model pricing",
  pricingUrl = site.linkAIModelPricingUrl,
} = Astro.props;
---

<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h3 class="cta-title">{heading}</h3>
      <p class="cta-desc">{description}</p>
      <div class="cta-buttons">
        <a href={primaryUrl} class="btn btn-primary" target="_blank" rel="noopener">
          {primaryLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={secondaryUrl} class="btn btn-secondary" target="_blank" rel="noopener">
          {secondaryLabel}
        </a>
        <a href={pricingUrl} class="btn btn-accent" target="_blank" rel="noopener">
          {pricingLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 48px 0;
  }

  .cta-box {
    background: linear-gradient(135deg, var(--surface) 0%, var(--accent-soft) 100%);
    border: 1.5px solid var(--accent-border);
    border-radius: var(--radius-2xl);
    padding: 40px 32px;
    text-align: center;
  }

  .cta-title {
    font-size: 24px;
    font-weight: 900;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 12px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-desc {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto 28px;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  @media (max-width: 600px) {
    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-buttons .btn {
      justify-content: center;
    }
  }
</style>
