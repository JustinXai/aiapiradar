---
import type { FAQItem } from '../data/pages';

interface Props {
  faq: FAQItem[];
}

const { faq } = Astro.props;
---

<section class="faq-section">
  <div class="container">
    <div class="faq-header">
      <span class="section-label">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        常见问题
      </span>
      <h2 class="section-title">FAQ</h2>
    </div>

    <div class="faq-list">
      {faq.map(item => (
        <div class="faq-item">
          <div class="faq-q">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:-2px;margin-right:6px;color:var(--accent)">
              <circle cx="12" cy="12" r="10"/>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            {item.question}
          </div>
          <div class="faq-a">{item.answer}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 48px 0;
  }

  .faq-header {
    margin-bottom: 32px;
  }

  .faq-list {
    max-width: 720px;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 20px 0;
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-q {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .faq-a {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    padding-left: 22px;
  }
</style>
